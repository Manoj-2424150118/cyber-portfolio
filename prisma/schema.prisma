datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Endorsement {
  id        String   @id @default(uuid())
  name      String
  role      String
  company   String?
  content   String
  rating    Int
  createdAt DateTime @default(now())
}
